{
  "cycle": {
    "_description": "季节与天气的确定性轮换规则。等值迁移自 map.weather.service.ts 硬编码（mde-stage1-coverage T1）。",
    "seasons": [
      "spring",
      "summer",
      "autumn",
      "winter"
    ],
    "weathers": [
      "sunny",
      "cloudy",
      "rainy",
      "snowy",
      "windy",
      "foggy"
    ],
    "seasonDays": 7,
    "rules": {
      "season": "seasonIndex = floor(dayOfYear / seasonDays % seasons.length)",
      "weather": "weatherIndex = floor(hourOfDay % weathers.length)"
    },
    "_consumers": {
      "seasons": [
        "map.weather.service.getCurrentSeason"
      ],
      "weathers": [
        "map.weather.service.getCurrentWeather"
      ],
      "seasonDays": [
        "map.weather.service.getCurrentSeason"
      ]
    }
  },
  "weatherEffects": {
