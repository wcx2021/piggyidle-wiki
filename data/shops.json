{
  "_meta": {
    "version": "1.0.0",
    "lastUpdated": "2026-08-19",
    "description": "系统商店配置（设置表）。金币商店出售普通物品（售价≥物品回收价shopPrice×5）；好猪商店出售永久权益（价格档位递增、越买越贵；权益解锁等级阶梯递增，声望1~200封顶120级）。小猪上限按档位出售两份（standard 便宜 / premium 加办更贵），同档两份解锁等级相同、价格不同、可叠加生效。修改此文件后运行 server/ 下 npm run seed:sync:full 同步到 server/data/shops.json。",
    "consumers": {
      "shops": [
        "shops.service",
        "staticResources.service",
        "gameRuleConfig(rules)"
      ]
    }
  },
  "rules": {
    "_description": "商店规则参数。等值迁移自 shop.service/shop.config.service/battle.instance.service 硬编码（mde-stage1-coverage T2），数值口径不变。",
    "previewLevelGap": 20,
    "benefitMaxQty": 1,
    "currencyItemIds": {
      "gold": 1000,
      "premium": 1001
    },
    "marketStampTaxRate": 0,
    "marketTradeTaxRate": 0.02,
    "marketTradeFreePriceThreshold": 0,
    "marketFloorUseShopPrice": true,
    "marketOrderDurationHours": 72,
    "marketAskBookLimit": 20,
    "marketPerItemOrderLimit": 5,
    "_consumers": {
      "previewLevelGap": [
        "shop.service.getShopItems（声望差超 20 档位隐藏）"
      ],
      "benefitMaxQty": [
        "shop.service.purchase（benefit 固定 1 份）",
        "shop.config.service.getFullMaxLevel",
        "shop.config.service.normalizeGoods"
      ],
      "currencyItemIds.gold": [
        "battle.instance.service.parseRewardTableForDisplay（金币判定/排除）"
      ],
      "marketPerItemOrderLimit": [
        "gameRuleConfig.loadMarketRules",
        "market.order.service.createOrder（单商品 open 挂单数 ≤ 该值校验）",
        "前端 GET /market/rules（提示文案，可选）"
      ]
    }
  },
  "_consumers": {
    "shops[].shopType": [
      "shop.service.getShopItems",
      "shop.service.purchase"
    ],
    "shops[].shopName": [
      "shop.service.getShopItems"
    ],
    "shops[].currency": [
      "shop.service.purchase（扣货币校验）"
    ],
    "shops[].goodsList[].goodsId": [
      "shop.service.getShopItems",
      "shop.service.purchase",
      "Save.shopPurchaseRecords"
    ],
    "shops[].goodsList[].type": [
      "shop.service.purchase（item/benefit 分发）"
    ],
    "shops[].goodsList[].itemId": [
      "shop.service.purchase（发放入背包）"
    ],
    "shops[].goodsList[].benefitType": [
      "shop.service.purchase（更新 Save.benefits）"
    ],
    "shops[].goodsList[].benefitUnit": [
      "shop.service（effectiveLimit 叠加）"
    ],
    "shops[].goodsList[].maxLevel": [
      "shop.service.purchase（满级 SHOP_BENEFIT_MAXED）"
    ],
    "shops[].goodsList[].variant": [
      "shop.service.getShopItems（standard便宜/premium加办）"
    ],
    "shops[].goodsList[].tier": [
      "shop.service.getShopItems（权益档位序号，用于同档两份识别）"
    ],
    "shops[].goodsList[].price": [
      "shop.service.getShopItems（展示）",
      "shop.service.purchase（item 扣价）"
    ],
    "shops[].goodsList[].priceByLevel": [
      "shop.service.purchase（benefit 多档购买时第N次价格）"
    ],
    "shops[].goodsList[].name": [
      "shop.service.getShopItems"
    ],
    "shops[].goodsList[].description": [
      "shop.service.getShopItems"
    ],
    "shops[].goodsList[].requiredLevel": [
      "shop.service.getShopItems（展示当前档解锁等级）",
      "shop.service.purchase（SHOP_LEVEL_LOCKED）"
    ],
    "shops[].goodsList[].requiredLevelByLevel": [
      "shop.service.purchase（多档购买时第N档解锁等级 SHOP_LEVEL_LOCKED）"
    ],
    "shops[].goodsList[].limitType": [
      "shop.service.purchase（once/perDay 限购）"
    ],
    "shops[].goodsList[].limitValue": [
      "shop.service.purchase（限购数量）"
    ],
    "shops[].goodsList[].isOnSale": [
      "shop.service.getShopItems（上架过滤）/ SHOP_GOODS_NOT_FOUND"
    ]
  },
